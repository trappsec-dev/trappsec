{
  "description": "Shared R17 cases for values_match(actual, expected). Loaded by the Python, Node and Go unit tests; every language must agree on every case. Values must be plain JSON and stay within what all three runtimes decode exactly: integers below 2^53, floats written without exponents.",
  "cases": [
    {"actual": "abc", "expected": "abc", "match": true, "note": "equal strings"},
    {"actual": "abc", "expected": "ABC", "match": false, "note": "strings compare exactly"},
    {"actual": "", "expected": "", "match": true},
    {"actual": "", "expected": 0, "match": false},

    {"actual": 5, "expected": 5, "match": true},
    {"actual": 5, "expected": 5.0, "match": true, "note": "integer and float are numerically equal"},
    {"actual": 1.5, "expected": 1.5, "match": true},
    {"actual": 3, "expected": 3.1, "match": false},
    {"actual": -1, "expected": -1, "match": true},
    {"actual": 0, "expected": -0, "match": true},

    {"actual": "5", "expected": 5, "match": true, "note": "form/query strings match the canonical form of a number"},
    {"actual": 5, "expected": "5", "match": true},
    {"actual": "5", "expected": 5.0, "match": true, "note": "integer-valued floats canonicalize without .0"},
    {"actual": "5.0", "expected": 5, "match": false},
    {"actual": "100", "expected": 100.0, "match": true},
    {"actual": "1.5", "expected": 1.5, "match": true},
    {"actual": "1.50", "expected": 1.5, "match": false},
    {"actual": "0.1", "expected": 0.1, "match": true},
    {"actual": "-3", "expected": -3, "match": true},
    {"actual": "-0", "expected": 0, "match": false},
    {"actual": "05", "expected": 5, "match": false},
    {"actual": "+5", "expected": 5, "match": false},
    {"actual": " 5", "expected": 5, "match": false},
    {"actual": "5 ", "expected": 5, "match": false},
    {"actual": "1e2", "expected": 100, "match": false},

    {"actual": true, "expected": true, "match": true},
    {"actual": false, "expected": false, "match": true},
    {"actual": true, "expected": false, "match": false},
    {"actual": "true", "expected": true, "match": true, "note": "booleans canonicalize to lowercase"},
    {"actual": "false", "expected": false, "match": true},
    {"actual": true, "expected": "true", "match": true},
    {"actual": "True", "expected": true, "match": false},
    {"actual": "TRUE", "expected": true, "match": false},
    {"actual": "false", "expected": true, "match": false},
    {"actual": "yes", "expected": true, "match": false},
    {"actual": "1", "expected": true, "match": false, "note": "booleans are never numbers"},
    {"actual": "0", "expected": false, "match": false},
    {"actual": true, "expected": 1, "match": false},
    {"actual": 1, "expected": true, "match": false},
    {"actual": false, "expected": 0, "match": false},
    {"actual": 0, "expected": false, "match": false},

    {"actual": null, "expected": null, "match": true},
    {"actual": null, "expected": 0, "match": false},
    {"actual": 0, "expected": null, "match": false},
    {"actual": null, "expected": "", "match": false},
    {"actual": "", "expected": null, "match": false},
    {"actual": null, "expected": false, "match": false},
    {"actual": "null", "expected": null, "match": false},

    {"actual": [], "expected": [], "match": true, "note": "arrays match element-wise with the same rules"},
    {"actual": [1, "a"], "expected": [1, "a"], "match": true},
    {"actual": [1, "a"], "expected": ["a", 1], "match": false, "note": "order matters"},
    {"actual": [1], "expected": [1, 1], "match": false},
    {"actual": [1.0], "expected": [1], "match": true},
    {"actual": ["5"], "expected": [5], "match": true, "note": "elements use loose matching too"},
    {"actual": [true], "expected": [1], "match": false},
    {"actual": [1], "expected": 1, "match": false, "note": "values_match itself never unwraps; see detect_honey_fields for multi-valued fields"},
    {"actual": "x", "expected": ["x"], "match": false},
    {"actual": "[]", "expected": [], "match": false},

    {"actual": {}, "expected": {}, "match": true, "note": "objects match key-wise with the same rules"},
    {"actual": {"a": 1.0}, "expected": {"a": 1}, "match": true},
    {"actual": {"a": "1"}, "expected": {"a": 1}, "match": true},
    {"actual": {"a": 1}, "expected": {"a": 1, "b": 2}, "match": false},
    {"actual": {"a": 1, "b": 2}, "expected": {"a": 1}, "match": false},
    {"actual": {"a": 1}, "expected": {"b": 1}, "match": false},
    {"actual": {"a": [1, {"b": "true"}]}, "expected": {"a": [1, {"b": true}]}, "match": true},
    {"actual": {"a": true}, "expected": {"a": 1}, "match": false},
    {"actual": {}, "expected": [], "match": false},
    {"actual": [], "expected": {}, "match": false}
  ]
}
